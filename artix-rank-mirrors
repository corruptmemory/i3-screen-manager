#!/usr/bin/python3
# artix-rank-mirrors — rank pacman mirrors by content freshness, then speed.
# Read-only: probes mirrors and prints a ranked mirrorlist; it never edits
# /etc/pacman.d itself. See docs/agent-guide/packages.md ("Mirror Freshness").
"""Rank Artix (or, with --arch, Arch [extra]) mirrors for pacman.

A mirror's lag is the number of packages in its sync databases that are older
than the same package on another probed mirror; zero lag means CURRENT. Lag is
judged from database CONTENT, never from Last-Modified headers, which some
mirrors misreport. Mirrors are ordered by how many staged repos they are current
in, then lag, then download speed, and the top
--count are emitted, so current mirrors always lead and a mirror that is merely
minutes into a sync can still serve as a fallback. pacman takes the sync
databases from the first mirror that answers, so a stale first entry produces
partial upgrades: e.g. [world] built against a newer [system] library than
the stale mirror serves, failing at runtime with "symbol lookup error".

Repositories are checked in stages: every candidate fetches the first (small)
repo database; only mirrors current there fetch the next (large) one. An Artix
run downloads roughly 20 MB plus about 6 MB per mirror still current after the
first stage (typically 100-150 MB, under a minute). --arch probes at most
--max-candidates mirrors, about 9 MB each.

Exit status: 0 = list written with a current first entry, 1 = list written but
even the first entry lags, 2 = usage/runtime error or no mirror answered.
"""

from __future__ import annotations

import argparse
import concurrent.futures as cf
import datetime as dt
import functools
import glob
import http.client
import io
import json
import os
import re
import socket
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.request

ARTIX_PACNEW = "/etc/pacman.d/mirrorlist.pacnew"
ARTIX_PKG_GLOB = "/var/cache/pacman/pkg/artix-mirrorlist-*.pkg.tar.*"
ARCH_STATUS_URL = "https://archlinux.org/mirrors/status/json/"
USER_AGENT = "artix-rank-mirrors (pacman mirror freshness check)"
ARCH = "x86_64"


def warn(msg: str) -> None:
    print(f"artix-rank-mirrors: {msg}", file=sys.stderr)


# --- candidate sources --------------------------------------------------------

def parse_servers(text: str) -> list[str]:
    """Server templates from a mirrorlist, including commented-out entries."""
    out: list[str] = []
    for line in text.splitlines():
        m = re.match(r"^\s*#?\s*Server\s*=\s*(\S+)", line)
        if m and m.group(1) not in out:
            out.append(m.group(1))
    return out


def artix_candidates(source: str | None) -> tuple[list[str], str]:
    """The full upstream list: --source, else the pacnew, else the cached package."""
    if source:
        with open(source, encoding="utf-8") as f:
            return parse_servers(f.read()), source
    if os.path.exists(ARTIX_PACNEW):
        with open(ARTIX_PACNEW, encoding="utf-8") as f:
            return parse_servers(f.read()), ARTIX_PACNEW
    pkgs = [p for p in glob.glob(ARTIX_PKG_GLOB) if not p.endswith(".sig")]
    if pkgs:
        pkg = max(pkgs, key=os.path.getmtime)
        r = subprocess.run(["bsdtar", "-xOf", pkg, "etc/pacman.d/mirrorlist"],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout:
            return parse_servers(r.stdout), pkg
    raise SystemExit(
        "artix-rank-mirrors: no full Artix mirror list found (no mirrorlist.pacnew, "
        "no cached artix-mirrorlist package); pass --source FILE")


def arch_candidates(countries: list[str], max_sync_hours: float, limit: int,
                    timeout: float) -> tuple[list[str], str]:
    """https, active, 100%-complete, recently synced mirrors from archlinux.org,
    best status score (lowest) first, capped at `limit` to bound downloads."""
    req = urllib.request.Request(ARCH_STATUS_URL, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        status = json.load(resp)
    now = dt.datetime.now(dt.timezone.utc)
    out = []
    for u in status.get("urls", []):
        if u.get("protocol") != "https" or not u.get("active"):
            continue
        if u.get("completion_pct") != 1 or not u.get("last_sync"):
            continue
        if countries and u.get("country_code") not in countries:
            continue
        synced = dt.datetime.fromisoformat(u["last_sync"].replace("Z", "+00:00"))
        if (now - synced).total_seconds() > max_sync_hours * 3600:
            continue
        if u.get("score") is None:
            continue
        out.append((u["score"], u["url"].rstrip("/") + "/$repo/os/$arch"))
    out.sort()
    return [url for _, url in out[:limit]], ARCH_STATUS_URL


# --- probing ------------------------------------------------------------------

def db_url(server: str, repo: str) -> str:
    return server.replace("$repo", repo).replace("$arch", ARCH) + f"/{repo}.db"


def probe(server: str, repo: str, timeout: float) -> dict:
    """Download one sync database; return its package->version map and speed."""
    url = db_url(server, repo)
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    t0 = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            # urlopen's timeout is per socket read; enforce a total deadline so
            # a mirror trickling bytes counts as failed instead of stalling.
            buf = bytearray()
            while chunk := resp.read(1 << 16):
                buf += chunk
                if time.monotonic() - t0 > timeout:
                    return {"ok": False, "error": f"slower than {timeout:g}s total"}
            data = bytes(buf)
    except urllib.error.HTTPError as e:
        return {"ok": False, "error": f"HTTP {e.code}"}
    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as e:
        reason = getattr(e, "reason", e)
        return {"ok": False, "error": str(reason)[:60]}
    secs = max(time.monotonic() - t0, 1e-3)
    pkgs: dict[str, str] = {}
    try:
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:*") as tar:
            for name in tar.getnames():
                top = name.split("/", 1)[0]
                parts = top.rsplit("-", 2)  # name-pkgver-pkgrel
                if len(parts) == 3:
                    pkgs[parts[0]] = f"{parts[1]}-{parts[2]}"
    except (tarfile.TarError, EOFError, OSError) as e:
        return {"ok": False, "error": f"bad database: {str(e)[:40]}"}
    if not pkgs:
        return {"ok": False, "error": "empty database"}
    return {"ok": True, "pkgs": pkgs, "bytes": len(data), "secs": secs}


@functools.lru_cache(maxsize=None)
def vercmp(a: str, b: str) -> int:
    """pacman's own version ordering."""
    r = subprocess.run(["vercmp", a, b], capture_output=True, text=True, check=True)
    return int(r.stdout.strip())


def behind_counts(results: dict[str, dict]) -> dict[str, int]:
    """Per mirror: how many of its packages are older than the newest seen anywhere."""
    newest: dict[str, str] = {}
    for res in results.values():
        for pkg, ver in res["pkgs"].items():
            cur = newest.get(pkg)
            if cur is None or (cur != ver and vercmp(ver, cur) > 0):
                newest[pkg] = ver
    return {srv: sum(1 for p, v in res["pkgs"].items() if v != newest[p])
            for srv, res in results.items()}


# --- main ---------------------------------------------------------------------

def main() -> int:
    ap = argparse.ArgumentParser(
        prog="artix-rank-mirrors",
        description="Rank pacman mirrors: current content first, then speed. "
                    "Prints a mirrorlist; never edits /etc/pacman.d.")
    ap.add_argument("--arch", action="store_true",
                    help="rank Arch mirrors for the [extra] overlay instead of Artix mirrors")
    ap.add_argument("--source", metavar="FILE",
                    help="Artix candidate mirrorlist (default: mirrorlist.pacnew, "
                         "else the cached artix-mirrorlist package)")
    ap.add_argument("--repos", metavar="LIST",
                    help="comma-separated repos, checked in stages "
                         "(default: system,world; with --arch: core,extra)")
    ap.add_argument("--country", metavar="CC,...", default="US,CA",
                    help="with --arch: mirror country codes, empty for all (default: US,CA)")
    ap.add_argument("--max-sync-age", metavar="HOURS", type=float, default=6.0,
                    help="with --arch: drop mirrors last synced longer ago (default: 6)")
    ap.add_argument("--max-candidates", metavar="N", type=int, default=20,
                    help="with --arch: probe only the N best by archlinux.org score "
                         "(default: 20; extra.db is ~9 MB per mirror)")
    ap.add_argument("--count", metavar="N", type=int, default=8,
                    help="mirrors to emit (default: 8)")
    ap.add_argument("--jobs", metavar="N", type=int, default=16,
                    help="parallel downloads (default: 16)")
    ap.add_argument("--timeout", metavar="SECS", type=float, default=30.0,
                    help="total time allowed per database download (default: 30)")
    ap.add_argument("-o", "--output", metavar="FILE",
                    help="write the list to FILE atomically instead of stdout")
    args = ap.parse_args()

    if min(args.count, args.jobs, args.max_candidates) < 1:
        ap.error("--count, --jobs and --max-candidates must be at least 1")
    repos = (args.repos or ("core,extra" if args.arch else "system,world")).split(",")
    repos = [r.strip() for r in repos if r.strip()]

    try:
        if args.arch:
            countries = [c.strip().upper() for c in args.country.split(",") if c.strip()]
            servers, source = arch_candidates(countries, args.max_sync_age,
                                              args.max_candidates, args.timeout)
        else:
            servers, source = artix_candidates(args.source)
    except (OSError, urllib.error.URLError, ValueError) as e:
        warn(f"cannot read candidate mirrors: {e}")
        return 2
    if not servers:
        warn(f"no candidate mirrors in {source}")
        return 2
    warn(f"{len(servers)} candidates from {source}; repos: {', '.join(repos)}")

    alive = list(servers)
    failed: dict[str, str] = {}
    behind: dict[str, int] = {s: 0 for s in servers}
    passed: dict[str, int] = {s: 0 for s in servers}   # stages current through
    speed: dict[str, float] = {}
    for stage, repo in enumerate(repos):
        with cf.ThreadPoolExecutor(max_workers=args.jobs) as pool:
            futs = {pool.submit(probe, s, repo, args.timeout): s for s in alive}
            results = {}
            for fut in cf.as_completed(futs):
                srv, res = futs[fut], fut.result()
                if res["ok"]:
                    results[srv] = res
                    speed[srv] = res["bytes"] / res["secs"]   # last (largest) repo wins
                else:
                    failed[srv] = f"{repo}: {res['error']}"
        if not results:
            warn(f"no mirror served {repo}.db")
            return 2
        counts = behind_counts(results)
        for srv, n in counts.items():
            behind[srv] += n
            if n == 0:
                passed[srv] += 1
        current = [s for s in results if counts[s] == 0]
        warn(f"{repo}: {len(results)} answered, {len(current)} current")
        # Only mirrors current so far carry on to the next (larger) database.
        if stage < len(repos) - 1:
            alive = current
        if not current:
            break

    # A mirror dropped after an early stage was never probed on later repos, so
    # its lag undercounts; rank by stages passed before comparing lag and speed.
    ranked = sorted((s for s in servers if s not in failed),
                    key=lambda s: (-passed[s], behind[s], -speed.get(s, 0.0)))
    chosen = ranked[:args.count]

    print(f"{'rank':>4}  {'behind':>6}  {'MB/s':>6}  server", file=sys.stderr)
    for i, s in enumerate(ranked, 1):
        mark = "*" if s in chosen else " "
        print(f"{i:>3}{mark}  {behind[s]:>6}  {speed.get(s, 0)/1048576:>6.2f}  {s}", file=sys.stderr)
    for s, why in sorted(failed.items()):
        print(f"   -  {'fail':>6}  {'':>6}  {s}  ({why})", file=sys.stderr)

    if not chosen:
        warn("no mirror answered; nothing written")
        return 2

    stamp = dt.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M %Z")
    kind = "Arch Linux [extra] overlay" if args.arch else "Artix Linux"
    lines = [
        "##",
        f"## {kind} mirrorlist, ranked {stamp} on {socket.gethostname()}",
        f"## by artix-rank-mirrors from {source} ({len(servers)} candidates).",
        f"## Ordered by lag (packages in [{'], ['.join(repos)}] older than on another",
        "## probed mirror, judged by database content), then fastest first.",
        f"## Current (zero lag): {sum(1 for s in chosen if behind[s] == 0)} of {len(chosen)}.",
        "##",
        *[f"Server = {s}" for s in chosen],
    ]
    text = "\n".join(lines) + "\n"
    if args.output:
        out_dir = os.path.dirname(os.path.abspath(args.output))
        fd, tmp = tempfile.mkstemp(dir=out_dir, prefix=".mirrorlist.")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, args.output)
    else:
        sys.stdout.write(text)

    if behind[chosen[0]] > 0:
        warn(f"even the first mirror lags by {behind[chosen[0]]} packages; "
             "pacman may see a partial upgrade — retry later")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
