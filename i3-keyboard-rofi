#!/usr/bin/env bash
#
# i3-keyboard-rofi — toggle keyboard remapping for laptop vs external keyboard.
#
# Laptop: Caps→Ctrl, both Shifts → CapsLock (cancel). External: no remapping
# (default US layout, real Caps Lock).
#
# Compositor-aware: uses `hyprctl` under Wayland/Hyprland, `setxkbmap` under
# X11/IceWM. Detection via $XDG_SESSION_TYPE with a $WAYLAND_DISPLAY fallback.
#

set -euo pipefail

# Silent-failure guard: shared _require helper. See
# ~/.local/lib/sh/require.sh (symlinked from i3-screen-manager/lib/require.sh)
# and docs/agent-guide/x11-input.md for dependency diagnostics.
. "$HOME/.local/lib/sh/require.sh"
_require rofi

LAPTOP_OPTS="ctrl:nocaps,shift:both_capslock_cancel"

is_wayland() {
    [[ "${XDG_SESSION_TYPE:-}" == "wayland" || -n "${WAYLAND_DISPLAY:-}" ]]
}

# --- Mode introspection (returns "laptop" or "external") ---

current_mode_wayland() {
    # The live value decides on every machine. The desktop's config sets no kb_options,
    # so "not overridden" does not mean the laptop remap is on.
    local raw
    raw=$(hyprctl getoption input:kb_options)
    if [[ "$raw" == *ctrl:nocaps* ]]; then
        echo "laptop"
    else
        echo "external"
    fi
}

current_mode_x11() {
    # `setxkbmap -query` returns current state. If `ctrl:nocaps` is among the
    # options, we're in laptop mode.
    if setxkbmap -query 2>/dev/null | grep -q '^options:.*ctrl:nocaps'; then
        echo "laptop"
    else
        echo "external"
    fi
}

current_mode() {
    if is_wayland; then _require hyprctl && current_mode_wayland
    else                _require setxkbmap && current_mode_x11
    fi
}

# --- Mode setters ---

# `hyprctl keyword` is gone under Hyprland's Lua config; eval applies it live instead.
# `hyprctl eval` prints "ok" on success and the error otherwise, for the notification.
set_kb_options_wayland() {
    local out
    out=$(hyprctl eval "hl.config({ input = { kb_options = \"$1\" } })" 2>&1) || true
    [[ "$out" == ok ]] && return 0
    echo "i3-keyboard-rofi: $out" >&2
    command -v notify-send >/dev/null &&
        notify-send -u critical "Keyboard" "Could not set keyboard options: $out"
    return 1
}
set_laptop_wayland()    { set_kb_options_wayland "$LAPTOP_OPTS"; }
set_external_wayland()  { set_kb_options_wayland ""; }

# `setxkbmap -option` (no value) clears all previously-set options; then a
# second invocation applies the new option set in one shot.
set_laptop_x11()    { setxkbmap -option ; setxkbmap -option "$LAPTOP_OPTS"; }
set_external_x11()  { setxkbmap -option ; }

set_laptop() {
    if is_wayland; then set_laptop_wayland; else set_laptop_x11; fi
}
set_external() {
    if is_wayland; then set_external_wayland; else set_external_x11; fi
}

# --- Rofi UI ---

mode=$(current_mode)

if [[ "$mode" == "laptop" ]]; then
    current="Laptop (Caps→Ctrl)"
    other="External (Default)"
else
    current="External (Default)"
    other="Laptop (Caps→Ctrl)"
fi

choice=$(printf "%s\n%s" "● $current" "  $other" \
    | rofi -dmenu -i -p "Keyboard" -theme-str 'window {width: 300px;}')

case "$choice" in
    *"Laptop"*)   set_laptop ;;
    *"External"*) set_external ;;
esac
