#!/usr/bin/env bash
# screenshot — Wayland/Hyprland screen capture with optional tensaku annotation.
#
# Usage: screenshot <region|full|clipboard> [--annotate]
#   region     drag-select a region (screen frozen during selection if
#              hyprpicker is present, so you capture exactly what you saw)
#   full       the active monitor
#   clipboard  annotate whatever image is currently on the clipboard
#              (always annotates; result goes back to the clipboard)
#
# region/full: capture -> save to ~/Pictures AND copy to the clipboard; with
# --annotate, hand off to tensaku (annotate -> back to the clipboard).
#
# Bound from dotfiles/.config/hypr/hyprland-desktop.lua (the Print family);
# flameshot stays on Super+Print as the fallback.
set -euo pipefail

mode="${1:-region}"
annotate=0
[[ "${2:-}" == "--annotate" ]] && annotate=1

_need() { command -v "$1" >/dev/null 2>&1 || { notify-send -u critical "screenshot" "missing: $1" 2>/dev/null; exit 1; }; }
_need grim
_need wl-copy

DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"
mkdir -p "$DIR"
FILE="$DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"

FREEZE_PID=""
freeze() {
    command -v hyprpicker >/dev/null 2>&1 || return 0
    hyprpicker -r -z >/dev/null 2>&1 &
    FREEZE_PID=$!
    sleep 0.1
}
unfreeze() { [[ -n "$FREEZE_PID" ]] && kill "$FREEZE_PID" 2>/dev/null || true; FREEZE_PID=""; }
trap unfreeze EXIT

case "$mode" in
    clipboard)
        _need tensaku-edit
        wl-paste --type image/png >"$FILE" 2>/dev/null || {
            notify-send -u critical "screenshot" "no image on the clipboard" 2>/dev/null
            rm -f "$FILE"
            exit 1
        }
        exec tensaku-edit "$FILE"
        ;;
    region)
        _need slurp
        freeze
        geom=$(slurp 2>/dev/null) || exit 0   # selection cancelled
        [[ -z "$geom" ]] && exit 0
        grim -g "$geom" "$FILE"
        unfreeze
        ;;
    full)
        mon=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.monitor // empty') || mon=""
        if [[ -n "$mon" ]]; then grim -o "$mon" "$FILE"; else grim "$FILE"; fi
        ;;
    *)
        echo "usage: screenshot <region|full|clipboard> [--annotate]" >&2
        exit 2
        ;;
esac

wl-copy --type image/png <"$FILE"

if (( annotate )) && command -v tensaku-edit >/dev/null 2>&1; then
    exec tensaku-edit "$FILE"
else
    notify-send "Screenshot" "Saved + copied: $(basename "$FILE")" -i "$FILE" 2>/dev/null || true
fi
