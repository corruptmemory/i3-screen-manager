# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
set -euo pipefail

mode="${1:-region}"
annotate=0
[[ "${2:-}" == "--annotate" ]] && annotate=1

_need() { command -v "$1" >/dev/null 2>&1 || { notify-send -u critical "screenshot" "missing: $1" 2>/dev/null; exit 1; }; }
_need grim
_need wl-copy

DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"
mkdir -p "$DIR"
FILE="$DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"

FREEZE_PID=""
freeze() {
    command -v hyprpicker >/dev/null 2>&1 || return 0
    hyprpicker -r -z >/dev/null 2>&1 &
    FREEZE_PID=$!
    sleep 0.1
}
unfreeze() { [[ -n "$FREEZE_PID" ]] && kill "$FREEZE_PID" 2>/dev/null || true; FREEZE_PID=""; }
trap unfreeze EXIT

# text/qr: select a region and keep its PNG in memory as base64 (a Bash variable
# cannot hold NUL bytes). The freeze ends as soon as grim has the image.
png=""
grab_region() {
    _need slurp
    freeze
    local geom
    geom=$(slurp 2>/dev/null) || exit 0   # selection cancelled
    [[ -z "$geom" ]] && exit 0
    png=$(grim -g "$geom" - | base64 -w0)
    unfreeze
}

case "$mode" in
    clipboard)
        _need tensaku-edit
        wl-paste --type image/png >"$FILE" 2>/dev/null || {
            notify-send -u critical "screenshot" "no image on the clipboard" 2>/dev/null
            rm -f "$FILE"
            exit 1
        }
        exec tensaku-edit "$FILE"
        ;;
    region)
        _need slurp
        freeze
        geom=$(slurp 2>/dev/null) || exit 0   # selection cancelled
        [[ -z "$geom" ]] && exit 0
        grim -g "$geom" "$FILE"
        unfreeze
        ;;
    full)
        mon=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.monitor // empty') || mon=""
        if [[ -n "$mon" ]]; then grim -o "$mon" "$FILE"; else grim "$FILE"; fi
        ;;
    text)
        _need tesseract
        grab_region
        out=$(base64 -d <<<"$png" | tesseract stdin stdout --oem 1 --psm 6 -l eng --dpi 300 \
                -c preserve_interword_spaces=1 2>/dev/null) || {
            notify-send -u critical "Text capture" "tesseract failed" 2>/dev/null
            exit 1
        }
        if [[ -z "${out//[[:space:]]/}" ]]; then
            notify-send "Text capture" "No text found" 2>/dev/null || true
            exit 1
        fi
        printf '%s' "$out" | wl-copy
        notify-send "Text capture" "Copied $(wc -l <<<"$out") line(s)" 2>/dev/null || true
        exit 0
        ;;
    qr)
        _need zbarimg
        grab_region
        # QR only: with every symbology enabled, dense screen content can decode as
        # an EAN or Code 39 barcode and take over the clipboard.
        out=$(base64 -d <<<"$png" | zbarimg -q --raw -Sdisable -Sqrcode.enable - 2>/dev/null) || out=""
        if [[ -z "$out" ]]; then
            notify-send "QR capture" "No QR code found" 2>/dev/null || true
            exit 1
        fi
        # QR codes often carry secrets, such as otpauth:// 2FA URIs, so the value
        # goes only to the clipboard, marked sensitive so a clipboard history
        # skips it; it is never printed or shown in the notification.
        printf '%s' "$out" | wl-copy --sensitive
        notify-send "QR capture" "Copied to the clipboard" 2>/dev/null || true
        exit 0
        ;;
    *)
        echo "usage: screenshot <region|full|clipboard|text|qr> [--annotate]" >&2
        exit 2
        ;;
esac

wl-copy --type image/png <"$FILE"

if (( annotate )) && command -v tensaku-edit >/dev/null 2>&1; then
    exec tensaku-edit "$FILE"
else
    notify-send "Screenshot" "Saved + copied: $(basename "$FILE")" -i "$FILE" 2>/dev/null || true
fi
