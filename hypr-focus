#!/usr/bin/env bash
# hypr-focus — i3-style directional focus for Hyprland that is group-aware.
#
# i3's `focus left/right` does two jobs with one key: cycle tabs inside a tabbed
# container, and move between windows. Hyprland SPLITS that into two dispatchers
# that cannot share a key without both firing and bouncing:
#   - `focus({direction})`  treats a group as ONE tile: moves between windows and
#     groups, never cycles tabs.
#   - `group.prev/next`     cycles tabs WITHIN the focused group, never leaves.
#
# This picks exactly one per keypress:
#   - active window is in a multi-window group -> group.prev/next  (cycle its tabs,
#                                                 wrapping within the group)
#   - otherwise                                -> focus({direction}) (move between
#                                                 tiled windows, i3-style)
#
# So on the ws10 comms wall, Super+left/right cycle the focused group's tabs
# (group A: Messages<->WhatsApp; group B: Discord->Keybase->Slack), and on any
# ordinary workspace they move focus between tiled windows. Jumping BETWEEN the
# two groups stays on Super+Ctrl+arrows (bindings.lua). ~6ms/press (one
# `hyprctl activewindow -j`), imperceptible.
#
# Deliberately NOT a cross-group "walk all N" traversal: exiting a group at its
# boundary means leaving the comms-wall monitor entirely (ws10 is alone on the
# portrait output), which reads as focus escaping to another screen. Cycle-within
# + Ctrl-to-switch is the predictable behavior.
#
# Launched by the Hyprland keybind, so it inherits the live session env; bare
# hyprctl is fine (and faster than hyprctl-live's per-call instance lookup).
#
# Usage: hypr-focus <left|right>   (bound to Super+left/right in bindings.lua)
set -uo pipefail

dir="${1:-}"
case "$dir" in
    left|right) ;;
    *) echo "usage: hypr-focus <left|right>" >&2; exit 2 ;;
esac

# In a multi-window group -> cycle tabs; else -> directional focus. `.grouped` is
# the member list (length>1 means grouped); decide in one jq off one snapshot.
grouped=$(hyprctl activewindow -j 2>/dev/null | jq -r '((.grouped // []) | length) > 1' 2>/dev/null)

if [ "$grouped" = "true" ]; then
    if [ "$dir" = "right" ]; then
        hyprctl dispatch 'hl.dsp.group.next()' >/dev/null 2>&1
    else
        hyprctl dispatch 'hl.dsp.group.prev()' >/dev/null 2>&1
    fi
else
    hyprctl dispatch "hl.dsp.focus({ direction = \"$dir\" })" >/dev/null 2>&1
fi
