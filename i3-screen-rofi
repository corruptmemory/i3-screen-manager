#!/usr/bin/env bash
#
# i3-screen-rofi — rofi menu for i3-screen-manager (Hyprland/Wayland)
#

set -euo pipefail

# Fail with a visible error rather than silently under `set -euo pipefail`.
# Same pattern applied across all the rofi menu scripts here after the
# emoji-picker vanish-silently-when-xclip-missing incident 2026-08-06.
_require() {
    local missing=() t name msg
    for t in "$@"; do command -v "$t" >/dev/null 2>&1 || missing+=("$t"); done
    [[ ${#missing[@]} -eq 0 ]] && return 0
    name=$(basename "$0")
    msg="required tool(s) not installed: ${missing[*]}"
    command -v notify-send >/dev/null 2>&1 && notify-send -u critical -t 6000 "$name" "$msg" || true
    echo "$name: $msg" >&2
    exit 1
}

_require rofi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MANAGER="$SCRIPT_DIR/i3-screen-manager"

has_external() {
    local ext
    ext=$("$MANAGER" status 2>/dev/null | awk '/^External:/ { print $2 }')
    [[ "$ext" != "none" ]]
}

build_menu() {
    if has_external; then
        echo "Extend Right"
        echo "Extend Left"
        echo "Extend Above"
        echo "Extend Below"
        echo "Clamshell (external only)"
        echo "Mirror (presentation)"
        echo "Adjust Scale"
        echo "Disconnect"
    else
        echo "No external display detected"
        echo "Adjust Scale"
    fi
}

run_selection() {
    case "$1" in
        "Extend Right")               "$MANAGER" extend-right ;;
        "Extend Left")                "$MANAGER" extend-left ;;
        "Extend Above")               "$MANAGER" extend-above ;;
        "Extend Below")               "$MANAGER" extend-below ;;
        "Clamshell (external only)")  "$MANAGER" clamshell ;;
        "Mirror (presentation)")      "$MANAGER" mirror ;;
        "Adjust Scale")               "$MANAGER" scale ;;
        "Disconnect")                 "$MANAGER" disconnect ;;
        *)                            exit 0 ;;
    esac
}

choice=$(build_menu | rofi -dmenu -i -p "Display" -theme-str 'window {width: 300px;}')

[[ -n "$choice" ]] && run_selection "$choice"
