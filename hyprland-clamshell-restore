#!/usr/bin/env bash
#
# hyprland-clamshell-restore: turn the laptop panel back off after a config reload while
# clamshell mode (i3-screen-manager clamshell) is on. A reload reapplies dotfiles'
# monitors.lua, which turns eDP-1 on. dotfiles' .config/hypr/autostart.lua runs this from
# its config.reloaded hook; without the clamshell inhibitor it does nothing.
#
# Hyprland's Lua config refuses `hyprctl keyword`, so the panel is set with
# `hyprctl eval 'hl.monitor({...})'`, whose errors are reported. hyprctl-live finds the
# running Hyprland from any shell. See docs/agent-guide/displays.md.
set -uo pipefail

INTERNAL=eDP-1
PIDFILE=/tmp/i3-screen-manager-inhibit.pid

[[ -f $PIDFILE ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null || exit 0

# Let the reload finish applying the config before overriding it.
sleep 1

out=$(hyprctl-live eval "hl.monitor({ output = \"$INTERNAL\", disabled = true })" 2>&1) || true
if [[ $out != ok ]]; then
    echo "hyprland-clamshell-restore: $out" >&2
    command -v notify-send >/dev/null &&
        notify-send -u critical "Clamshell" "Could not turn $INTERNAL off after a config reload: $out"
    exit 1
fi
sleep 0.2
# The compositor's disable can leave the panel lit; cut the output too.
wlr-randr --output "$INTERNAL" --off 2>/dev/null || true
